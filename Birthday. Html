<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Birthday Surprise 🎂</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    font-family: Arial, sans-serif;
    background: linear-gradient(135deg, #ff9a9e, #fad0c4, #a18cd1);
}

/* Background sparkles */
.sparkle {
    position: absolute;
    color: white;
    font-size: 20px;
    animation: sparkle 2s infinite alternate;
}

.s1 { top: 10%; left: 15%; }
.s2 { top: 20%; right: 15%; animation-delay: .5s; }
.s3 { bottom: 15%; left: 20%; animation-delay: 1s; }
.s4 { bottom: 20%; right: 20%; animation-delay: 1.5s; }

@keyframes sparkle {
    from { opacity: .2; transform: scale(.7); }
    to { opacity: 1; transform: scale(1.4); }
}

/* Card */
.card {
    width: 320px;
    height: 430px;
    position: relative;
    perspective: 1200px;
    cursor: pointer;
}

.card-inner {
    width: 100%;
    height: 100%;
    position: relative;
    transform-style: preserve-3d;
    transition: transform 1.2s ease;
}

.card.open .card-inner {
    transform: rotateY(-180deg);
}

.front, .inside {
    position: absolute;
    width: 100%;
    height: 100%;
    border-radius: 22px;
    backface-visibility: hidden;
    box-shadow: 0 20px 45px rgba(0,0,0,.25);
}

/* Front */
.front {
    background: linear-gradient(145deg, #ff4f81, #ff8fab);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    color: white;
}

.front h2 {
    font-size: 32px;
    margin: 10px;
}

.front p {
    font-size: 16px;
}

.gift {
    font-size: 75px;
    animation: bounce 1.5s infinite;
}

@keyframes bounce {
    50% { transform: translateY(-15px); }
}

/* Inside */
.inside {
    transform: rotateY(180deg);
    background: linear-gradient(160deg, #fff0f5, #ffffff);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 25px;
}

.inside h1 {
    font-size: 43px;
    margin: 10px 0;
    background: linear-gradient(90deg, #ff2d75, #9b51e0);
    -webkit-background-clip: text;
    color: transparent;
    animation: pop 1s ease;
}

.inside h2 {
    color: #ff4f81;
}

.cake {
    font-size: 65px;
    animation: cake 1s infinite alternate;
}

@keyframes cake {
    to { transform: scale(1.12); }
}

@keyframes pop {
    from {
        opacity: 0;
        transform: scale(.3);
    }
    to {
        opacity: 1;
        transform: scale(1);
    }
}

/* Balloons */
.balloon {
    position: absolute;
    bottom: -100px;
    font-size: 45px;
    animation: fly 6s linear infinite;
}

.b1 { left: 5%; animation-delay: 0s; }
.b2 { left: 25%; animation-delay: 1s; }
.b3 { left: 70%; animation-delay: 2s; }
.b4 { left: 88%; animation-delay: 3s; }

@keyframes fly {
    from {
        bottom: -100px;
        opacity: 1;
    }
    to {
        bottom: 110%;
        opacity: 0;
        transform: rotate(15deg);
    }
}

/* Confetti */
.confetti {
    position: absolute;
    top: -20px;
    width: 9px;
    height: 15px;
    animation: fall 4s linear infinite;
}

@keyframes fall {
    to {
        transform: translateY(110vh) rotate(720deg);
    }
}

/* Hint */
.hint {
    position: absolute;
    bottom: 20px;
    color: white;
    font-size: 14px;
}
</style>
</head>

<body>

<div class="sparkle s1">✨</div>
<div class="sparkle s2">⭐</div>
<div class="sparkle s3">✨</div>
<div class="sparkle s4">💫</div>

<div class="balloon b1">🎈</div>
<div class="balloon b2">🎈</div>
<div class="balloon b3">🎈</div>
<div class="balloon b4">🎈</div>

<div class="card" onclick="openCard()">

    <div class="card-inner">

        <!-- FRONT -->
        <div class="front">
            <div class="gift">🎁</div>
            <h2>A Special Surprise</h2>
            <p>Tap to open 💕</p>
        </div>

        <!-- INSIDE -->
        <div class="inside">
            <div class="cake">🎂</div>

            <h1>HAPPY<br>BIRTHDAY!</h1>

            <h2>🎉 Have a Wonderful Day! 🎉</h2>

            <p>
                May your day be filled with<br>
                happiness, smiles & beautiful moments ✨
            </p>
        </div>

    </div>
</div>

<div class="hint">Tap the card to open 💌</div>

<script>

/* Open card + start music */
function openCard() {

    const card = document.querySelector(".card");

    card.classList.toggle("open");

    if (card.classList.contains("open")) {
        startMusic();
        createConfetti();
    }
}

/* Simple Happy Birthday style melody */
let audioContext;
let musicStarted = false;

function startMusic() {

    if (musicStarted) return;

    musicStarted = true;

    audioContext = new (window.AudioContext ||
        window.webkitAudioContext)();

    const notes = [
        264, 264, 297, 264, 352, 330,
        264, 264, 297, 264, 396, 352
    ];

    notes.forEach((frequency, index) => {

        const oscillator =
            audioContext.createOscillator();

        const gain =
            audioContext.createGain();

        oscillator.frequency.value = frequency;
        oscillator.type = "sine";

        oscillator.connect(gain);
        gain.connect(audioContext.destination);

        const time =
            audioContext.currentTime + index * 0.38;

        gain.gain.setValueAtTime(0.0001, time);
        gain.gain.exponentialRampToValueAtTime(
            0.15, time + 0.03
        );

        gain.gain.exponentialRampToValueAtTime(
            0.0001, time + 0.32
        );

        oscillator.start(time);
        oscillator.stop(time + 0.34);
    });
}

/* Confetti */
function createConfetti() {

    for (let i = 0; i < 80; i++) {

        const piece = document.createElement("div");

        piece.className = "confetti";

        piece.style.left =
            Math.random() * 100 + "vw";

        piece.style.animationDelay =
            Math.random() * 3 + "s";

        piece.style.transform =
            "rotate(" + Math.random() * 360 + "deg)";

        document.body.appendChild(piece);

        setTimeout(() => {
            piece.remove();
        }, 5000);
    }
}

</script>

</body>
</html>